{
  "compilerOptions": {
    "target": "es2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "types": ["@cloudflare/workers-types", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    // On, and it has to be: `@cloudflare/workers-types` and `@types/node` both
    // declare `console`, `crypto`, `Blob`, `TextDecoder` and two dozen more,
    // so checking them together reports about forty conflicts that belong to
    // neither package. Mallok's own published declarations are checked with it
    // off, by a consumer project that installs the tarball and nothing else —
    // that is the setting that caught them reaching for zod, mdast and hast.
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "*.ts"]
}
