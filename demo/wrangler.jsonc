{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mallok-demo",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "assets": {
    "directory": "../dist/demo",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "demo.mallok.dev", "custom_domain": true }]
}
