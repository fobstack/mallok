{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers/types"
    ]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "text-modules.d.ts",
    "scripts/**/*.mjs"
  ],
  // `src/admin` and `src/runtime/react` run in a browser and need the DOM
  // library, which cannot share a project with the Workers types. Each has its
  // own tsconfig, and `pnpm typecheck` runs all of them.
  "exclude": [
    "src/admin",
    "test/admin",
    "src/runtime/react",
    "test/runtime/dom"
  ]
}
