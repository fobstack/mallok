{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mallok.dev/schemas/candidate-inventory-v1.json",
  "title": "Mallok immutable Cloudflare candidate inventory v1",
  "x-mallok-runtimeConstraints": {
    "exactSnapshotSet": "entries must cover every regular file below `.mallok/candidates/${candidateInputHash}` exactly once and no other file; symlinks, junctions, directories and special files are not entries and are rejected during traversal.",
    "requiredSingletons": "Exactly one worker entry at worker/index.js, one build-manifest entry at build-manifest.json and one asset-manifest entry at asset-manifest.json are required. Every remaining entry is kind asset below assets/.",
    "canonicalOrdering": "entries are unique by path and serialized in Unicode code-unit ascending path order.",
    "inventoryHash": "The inventory hash is SHA-256 over canonical JSON bytes of this entire object. The inventory file is stored outside the candidate snapshot, so it does not create a self-reference."
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "candidateInputHash", "entries"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "candidateInputHash": {"$ref": "#/$defs/hash"},
    "entries": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10003,
      "uniqueItems": true,
      "x-mallok-uniqueBy": "path",
      "x-mallok-orderBy": "path:unicode-code-unit-ascending",
      "allOf": [
        {
          "contains": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "worker"}}},
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "build-manifest"}}},
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "asset-manifest"}}},
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/worker"},
          {"$ref": "#/$defs/buildManifest"},
          {"$ref": "#/$defs/assetManifest"},
          {"$ref": "#/$defs/asset"}
        ]
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "kind"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"$ref": "#/$defs/hash"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 209715200},
        "kind": {"type": "string"}
      }
    },
    "worker": {
      "allOf": [
        {"$ref": "#/$defs/baseEntry"},
        {"type": "object", "properties": {"path": {"const": "worker/index.js"}, "kind": {"const": "worker"}}}
      ]
    },
    "buildManifest": {
      "allOf": [
        {"$ref": "#/$defs/baseEntry"},
        {"type": "object", "properties": {"path": {"const": "build-manifest.json"}, "kind": {"const": "build-manifest"}}}
      ]
    },
    "assetManifest": {
      "allOf": [
        {"$ref": "#/$defs/baseEntry"},
        {"type": "object", "properties": {"path": {"const": "asset-manifest.json"}, "kind": {"const": "asset-manifest"}}}
      ]
    },
    "asset": {
      "allOf": [
        {"$ref": "#/$defs/baseEntry"},
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.[^/]*)?(?:/|$))(?!.*[?#%:])(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f])assets/[^/]+(?:/[^/]+)*$",
              "description": "Runtime additionally requires NFC, at most 32 non-empty segments, 1,024 UTF-8 bytes total and 255 UTF-8 bytes per segment.",
              "x-mallok-normalization": "NFC",
              "x-mallok-maxSegments": 32,
              "x-mallok-maxUtf8Bytes": 1024,
              "x-mallok-maxSegmentUtf8Bytes": 255
            },
            "bytes": {"type": "integer", "maximum": 20971520},
            "kind": {"const": "asset"}
          }
        }
      ]
    }
  }
}
