<!doctype html>
<html lang="{{ page.locale }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if page.kind == "home" %}{{ site.name }} — {{ site.tagline }}{% else %}{{ page.title }} — {{ site.name }}{% endif %}</title>
  {% if page.description != "" %}<meta name="description" content="{{ page.description }}">{% endif %}
  <link rel="canonical" href="{{ page.canonical }}">
  {{ page.head }}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap">
  <link rel="stylesheet" href="{{ theme.asset_base }}/style.css">
</head>
<body>
  <a class="skip" href="#main">{{ t.skip }}</a>
  {% render "partials/header" %}
  <main id="main">{% block content %}{% endblock %}</main>
  {% render "partials/footer" %}
</body>
</html>
