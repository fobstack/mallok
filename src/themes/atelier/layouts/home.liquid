{% layout "layouts/base" %}
{% block content %}
<section class="hero-carousel" data-carousel role="region" aria-roledescription="{{ t.carousel }}" aria-label="{{ t.hero_collection }}">
  <div class="hero-stage">
    {% for number in (1..3) %}
      {% case number %}
      {% when 1 %}{% assign slide_name = t.slide_materials %}{% assign slide_title = theme.options.hero_title %}{% assign slide_lede = theme.options.hero_lede %}{% assign slide_image = "hero-materials" %}{% assign slide_alt = t.material_photo %}{% assign slide_cta = t.all_products %}{% assign slide_href = "#products" %}
      {% when 2 %}{% assign slide_name = t.slide_processing %}{% assign slide_title = t.processing_title %}{% assign slide_lede = t.processing_lede %}{% assign slide_image = "hero-processing" %}{% assign slide_alt = t.processing_photo %}{% assign slide_cta = t.processing_cta %}{% assign slide_href = "#capabilities" %}
      {% when 3 %}{% assign slide_name = t.slide_quality %}{% assign slide_title = t.quality_title %}{% assign slide_lede = t.quality_lede %}{% assign slide_image = "hero-quality" %}{% assign slide_alt = t.quality_photo %}{% assign slide_cta = t.quality_cta %}{% assign slide_href = theme.options.quote_href %}
      {% endcase %}
      <div class="hero-slide" id="hero-slide-{{ number }}" role="group" aria-roledescription="{{ t.slide }}" aria-label="{{ number }} / 3 — {{ slide_name }}" data-slide>
        <picture class="hero-slide-media">
          <source media="(max-width: 47.99rem)" srcset="{{ theme.asset_base }}/images/{{ slide_image }}-mobile.jpg">
          <img src="{{ theme.asset_base }}/images/{{ slide_image }}.jpg" width="1536" height="1024" alt="{{ slide_alt }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"{% if forloop.first %} fetchpriority="high"{% endif %} decoding="async">
        </picture>
        <div class="shell hero-slide-inner">
          <div class="hero-slide-copy">
            <p class="hero-slide-label">{{ slide_name }}</p>
            {% if forloop.first %}<h1>{{ slide_title }}</h1>{% else %}<h2>{{ slide_title }}</h2>{% endif %}
            <p class="hero-slide-lede">{{ slide_lede }}</p>
            <a class="btn hero-slide-cta" href="{{ slide_href }}">{{ slide_cta }} <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
  <div class="shell hero-controls">
    <nav class="hero-selectors" aria-label="{{ t.choose_slide }}">
      <a href="#hero-slide-1" data-slide-link="0" aria-current="true"><span aria-hidden="true">01</span>{{ t.slide_materials }}</a>
      <a href="#hero-slide-2" data-slide-link="1"><span aria-hidden="true">02</span>{{ t.slide_processing }}</a>
      <a href="#hero-slide-3" data-slide-link="2"><span aria-hidden="true">03</span>{{ t.slide_quality }}</a>
    </nav>
    <div class="hero-arrows" hidden data-carousel-arrows>
      <button type="button" data-prev aria-label="{{ t.previous_slide }}">←</button>
      <button type="button" data-next aria-label="{{ t.next_slide }}">→</button>
    </div>
    <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-carousel-status></p>
  </div>
</section>
<script src="{{ theme.asset_base }}/hero-carousel.js" defer></script>

{% assign certs = theme.options.certifications | split: "," %}
{% if certs.size > 0 %}
<section class="certs" aria-label="{{ t.trust }}">
  <span class="certs-label">{{ t.certified }}</span>
  {% for cert in certs %}<span class="cert-pill">{{ cert | strip }}</span>{% endfor %}
</section>
{% endif %}

{% if recent.product.size > 0 %}
<section class="products shell" id="products">
  <div class="section-head">
    <div>
      <p class="eyebrow">{{ t.product_range }}</p>
      <h2>{{ t.products_title }}</h2>
    </div>
    {% for item in site.nav %}{% if forloop.first %}
    <a class="section-link" href="{{ item.href }}">{{ t.all_products }}
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10m0 0L9 4m4 4l-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
    {% endif %}{% endfor %}
  </div>
  <div class="card-grid">
    {% for item in recent.product limit: 3 %}
    <a class="card" href="{{ item.path }}">
      <div class="card-art card-art-{{ forloop.index }}">
        {% if item.cover != blank %}
        <img src="{{ item.cover }}" alt="{{ item.title }}" width="960" height="720" loading="lazy" decoding="async">
        {% elsif item.frontmatter.form == "Tube" or item.frontmatter.form == "管材" %}
        <img src="{{ theme.asset_base }}/images/tubes.jpg" srcset="{{ theme.asset_base }}/images/tubes-768.jpg 768w, {{ theme.asset_base }}/images/tubes.jpg 1536w" sizes="(max-width: 47.99rem) 100vw, 50vw" alt="{{ t.material_photo }}" width="1536" height="1152" loading="lazy" decoding="async">
        {% elsif item.frontmatter.form == "Plate" or item.frontmatter.form == "Sheet" or item.frontmatter.form == "板材" %}
        <img src="{{ theme.asset_base }}/images/plates.jpg" srcset="{{ theme.asset_base }}/images/plates-768.jpg 768w, {{ theme.asset_base }}/images/plates.jpg 1536w" sizes="(max-width: 47.99rem) 100vw, 50vw" alt="{{ t.plate_photo }}" width="1536" height="1152" loading="lazy" decoding="async">
        {% else %}
        <img src="{{ theme.asset_base }}/images/bars.jpg" srcset="{{ theme.asset_base }}/images/bars-768.jpg 768w, {{ theme.asset_base }}/images/bars.jpg 1536w" sizes="(max-width: 47.99rem) 100vw, 50vw" alt="{{ t.bar_photo }}" width="1536" height="1152" loading="lazy" decoding="async">
        {% endif %}
        {% if item.frontmatter.grade %}<span class="card-tag">{{ item.frontmatter.grade }}</span>{% endif %}
      </div>
      <div class="card-body">
        <h3>{{ item.title }}</h3>
        {% if item.description != "" %}<p>{{ item.description }}</p>{% endif %}
        <div class="card-foot">
          <span>{% if item.frontmatter.moq %}{{ t.moq }} {{ item.frontmatter.moq }}{% endif %}{% if item.frontmatter.lead_time %} · {{ item.frontmatter.lead_time }}{% endif %}</span>
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10m0 0L9 4m4 4l-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
      </div>
    </a>
    {% endfor %}
  </div>
</section>
{% endif %}

<section class="shell">
  <div class="band" id="capabilities">
    <img class="band-image" src="{{ theme.asset_base }}/images/bars.jpg" srcset="{{ theme.asset_base }}/images/bars-768.jpg 768w, {{ theme.asset_base }}/images/bars.jpg 1536w" sizes="(max-width: 47.99rem) 100vw, 50vw" width="1536" height="1152" alt="{{ t.bar_photo }}" loading="lazy" decoding="async">
    <div>
      <h2 class="band-title">{{ theme.options.band_title }}</h2>
      <p class="band-lede">{{ theme.options.band_lede }}</p>
    </div>
    <div class="band-features">
      {% assign features = theme.options.band_features | split: ";;" %}
      {% for feature in features %}
        {% assign bits = feature | split: "|" %}
        <div class="feature">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.4-7 10-4-1.6-7-5.5-7-10V6l7-3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <div><strong>{{ bits[0] | strip }}</strong><span>{{ bits[1] | strip }}</span></div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% if recent.article.size > 0 %}
<section class="notes shell">
  <div class="section-head">
    <h2>{{ t.from_the_mill }}</h2>
  </div>
  <div class="note-grid">
    {% for item in recent.article limit: 3 %}
    <a class="note-card" href="{{ item.path }}">
      <time datetime="{{ item.published_at }}">{{ item.published_at | date: "%d %b %Y" }}</time>
      <h3>{{ item.title }}</h3>
      {% if item.description != "" %}<p>{{ item.description }}</p>{% endif %}
    </a>
    {% endfor %}
  </div>
</section>
{% endif %}

<section class="shell">
  <div class="cta">
    <div>
      <h2>{{ theme.options.cta_title }}</h2>
      <p>{{ theme.options.cta_lede }}</p>
    </div>
    <a class="btn btn-solid btn-lg" href="{{ theme.options.quote_href }}">{{ t.request_quote }}</a>
  </div>
</section>
{% endblock %}
