{% layout "layouts/base" %}
{% block content %}
  <section class="list">
    <h1>{{ page.title }}</h1>
    <ul class="post-list">
      {% for item in list.items %}
        <li>
          <a href="{{ item.path }}">{{ item.title }}</a>
          <time datetime="{{ item.published_at }}">{{ item.published_at | date: "%Y-%m-%d" }}</time>
          {% if item.description != "" %}<p>{{ item.description }}</p>{% endif %}
        </li>
      {% endfor %}
    </ul>
    <nav class="pagination">
      {% if list.prev_path != "" %}<a href="{{ list.prev_path }}">← {{ t.newer }}</a>{% endif %}
      {% if list.has_next %}<a href="{{ list.next_path }}">{{ t.older }} →</a>{% endif %}
    </nav>
  </section>
{% endblock %}
