{% layout "layouts/base" %}
{% block content %}
<section class="col wire">
  <h1 class="index-title">{{ page.title }}</h1>
  <div class="wire-grid">
    {% for item in list.items %}
    <a class="brief sec-{{ item.frontmatter.section }}" href="{{ item.path }}">
      <span class="brief-art"></span>
      <h3>{{ item.title }}</h3>
      {% if item.description != "" %}<p>{{ item.description }}</p>{% endif %}
      <time datetime="{{ item.published_at }}">{{ item.published_at | date: "%d %b %Y" }}</time>
    </a>
    {% endfor %}
  </div>
  <nav class="pager" aria-label="{{ t.pagination }}">
    {% if list.prev_path != "" %}<a href="{{ list.prev_path }}">← {{ t.newer }}</a>{% endif %}
    {% if list.has_next %}<a href="{{ list.next_path }}">{{ t.older }} →</a>{% endif %}
  </nav>
</section>
{% endblock %}
