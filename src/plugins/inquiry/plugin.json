{
  "id": "inquiry",
  "name": "Inquiry",
  "version": "0.2.0",
  "description": "A zero-JavaScript inquiry form with spam protection, email notification and an admin panel.",
  "pluginApi": 1,
  "hooks": ["afterRender"],
  "routes": [
    {
      "path": "submit",
      "method": "POST",
      "turnstile": true,
      "rateLimit": true
    }
  ],
  "settings": {
    "recipient": {
      "type": "string",
      "label": "Recipient email",
      "required": true
    },
    "from_address": {
      "type": "string",
      "advanced": true,
      "label": "From address for inquiry email",
      "help": "Empty uses the sender in Settings → Email."
    },
    "autoreply": {
      "type": "boolean",
      "label": "Send buyers an automatic confirmation",
      "default": true
    },
    "turnstile_sitekey": {
      "type": "string",
      "advanced": true,
      "label": "Turnstile site key",
      "help": "Empty turns the anti-spam widget off."
    },
    "thanks_path": {
      "type": "string",
      "advanced": true,
      "label": "Thank-you page path",
      "default": "/thank-you"
    },
    "autoreply_subject": {
      "type": "string",
      "advanced": true,
      "label": "Autoreply subject",
      "help": "Liquid. Empty uses the built-in template for each language."
    },
    "autoreply_body": {
      "type": "text",
      "advanced": true,
      "label": "Autoreply body",
      "help": "Liquid. Variables: name, site_name, company, message."
    },
    "blocked_countries": {
      "type": "string[]",
      "advanced": true,
      "label": "Blocked countries",
      "help": "Two-letter ISO 3166-1 codes. Their inquiries are stored as spam."
    },
    "blocked_keywords": {
      "type": "string[]",
      "advanced": true,
      "label": "Blocked keywords",
      "help": "Inquiries that contain one are stored as spam."
    }
  },
  "secrets": {
    "turnstile_secret": {
      "label": "Turnstile secret key",
      "required": false
    }
  },
  "panels": [
    {
      "id": "inquiries",
      "label": "Inquiries",
      "type": "table",
      "table": "p_inquiry_inquiry",
      "columns": [
        {
          "field": "name",
          "label": "Name"
        },
        {
          "field": "email",
          "label": "Email",
          "type": "email"
        },
        {
          "field": "message",
          "label": "Message"
        },
        {
          "field": "country",
          "label": "Country"
        },
        {
          "field": "status",
          "label": "Status",
          "type": "badge"
        },
        {
          "field": "created_at",
          "label": "Received",
          "type": "datetime"
        }
      ],
      "filters": ["status"],
      "detail": ["message", "company", "phone", "source_path", "locale"],
      "orderBy": "created_at",
      "actions": [
        {
          "id": "mark_replied",
          "label": "Mark replied",
          "type": "update"
        },
        {
          "id": "mark_spam",
          "label": "Mark spam",
          "type": "update"
        },
        {
          "id": "export_csv",
          "label": "Export CSV",
          "type": "download"
        }
      ]
    }
  ],
  "affectsFragmentCache": false,
  "clientScripts": [
    {
      "src": "https://challenges.cloudflare.com/turnstile/v0/api.js",
      "purpose": "Turnstile anti-spam widget on the inquiry form"
    }
  ]
}
